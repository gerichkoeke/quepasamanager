// Prisma schema for Integrador Waha-Typebot
// Cache-bust: 2026-05-20 13:40

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_settings")
}

model SessionMapping {
  id                  String   @id @default(uuid())
  sessionId           String   @map("session_id")
  typebotFlowId       String   @map("typebot_flow_id")
  typebotHost         String   @map("typebot_host")
  typebotApiKey       String?  @map("typebot_api_key")
  chatwootBaseUrl     String?  @map("chatwoot_base_url") // Chatwoot instance URL
  chatwootApiToken    String?  @map("chatwoot_api_token") // Chatwoot API access token
  chatwootAccountId   String?  @map("chatwoot_account_id") // Chatwoot account ID
  chatwootInboxId     String?  @map("chatwoot_inbox_id") // Chatwoot inbox ID
  webhookToken        String?  @map("webhook_token")
  publicToken         String?  @unique @map("public_token") // Token for public connection page
  restartKeyword      String?  @map("restart_keyword")
  sessionTimeout      Int?     @map("session_timeout") // Timeout in minutes
  pauseOnTakeover     Boolean  @default(true) @map("pause_on_takeover") // Pause bot when owner takes over conversation
  ownerResumeKeyword  String?  @map("owner_resume_keyword") // Keyword for owner to resume bot for a customer
  enableGroups        Boolean  @default(false) @map("enable_groups") // Enable bot to work in WhatsApp groups
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([sessionId, active])
  @@map("session_mappings")
}

model TypebotSession {
  id                String   @id @default(uuid())
  sessionId         String   @map("session_id")
  phone             String
  typebotSessionId  String   @map("typebot_session_id")
  lastMessageId     String?  @map("last_message_id")
  botPaused         Boolean  @default(false) @map("bot_paused")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([sessionId, phone])
  @@index([sessionId])
  @@map("typebot_sessions")
}

model NativeBotSession {
  id                String   @id @default(uuid())
  quepasaMappingId  String   @map("quepasa_mapping_id")
  phone             String
  state             String   @default("menu") // "menu", "paused"
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([quepasaMappingId, phone])
  @@index([quepasaMappingId])
  @@map("native_bot_sessions")
}

model QuepasaMapping {
  id                        String   @id @default(uuid())
  quepasaToken              String   @unique @map("quepasa_token") // Unique token for X-QUEPASA-TOKEN header
  phoneNumber               String?  @unique @map("phone_number") // Quepasa phone number (optional, can be filled later)
  name                      String // Friendly name for this mapping (required)
  chatwootBaseUrl           String   @map("chatwoot_base_url") // Chatwoot instance URL
  chatwootApiToken          String   @map("chatwoot_api_token") // Chatwoot API access token
  chatwootAccountId         String   @map("chatwoot_account_id") // Chatwoot account ID
  chatwootInboxId           String   @map("chatwoot_inbox_id") // Chatwoot inbox ID
  chatwootInboxName         String?  @map("chatwoot_inbox_name") // Custom name for Chatwoot inbox (optional)
  closingMessage            String?  @map("closing_message") // Mensagem enviada ao finalizar chamado
  returnWebhookUrl          String?  @map("return_webhook_url") // Webhook de retorno/finalização
  useTypebot                Boolean  @default(false) @map("use_typebot") // Enable typebot integration
  typebotFlowId             String?  @map("typebot_flow_id") // ID do fluxo do typebot
  typebotHost               String?  @map("typebot_host") // URL do typebot
  typebotApiKey             String?  @map("typebot_api_key") // (Opcional) Chave da API do typebot
  useNativeBot              Boolean  @default(false) @map("use_native_bot")
  botMenuType               String   @default("text") @map("bot_menu_type") // text or list
  botWelcomeMessage         String?  @map("bot_welcome_message")
  botOptions                Json?    @map("bot_options") // JSON array for bot options
  botInvalidMessage         String?  @map("bot_invalid_message")
  provider                  String   @default("quepasa") @map("provider") // quepasa or official
  officialPhoneId           String?  @map("official_phone_id")
  officialApiToken          String?  @map("official_api_token")
  officialWabaId            String?  @map("official_waba_id")
  successNotificationSent   Boolean  @default(false) @map("success_notification_sent") // Track if success notification was sent
  enableGroups              Boolean  @default(false) @map("enable_groups") // Enable receiving messages from WhatsApp groups
  rejectCalls               Boolean  @default(false) @map("reject_calls") // Reject incoming WhatsApp calls
  reopenClosedTickets       Boolean  @default(false) @map("reopen_closed_tickets") // Reopen closed tickets for returning customers
  showAgentName             Boolean  @default(false) @map("show_agent_name") // Show agent name in messages sent to WhatsApp
  maxMessageAgeMinutes      Int      @default(5) @map("max_message_age_minutes") // Ignore messages older than this
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([phoneNumber, active])
  @@map("quepasa_mappings")
}

enum Direction {
  in
  out
}

enum Provider {
  typebot
  quepasa
  chatwoot
}

model EventLog {
  id        String   @id @default(uuid())
  direction Direction
  provider  Provider
  sessionId String?  @map("session_id")
  peer      String?
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@map("event_logs")
}

model TypebotFlow {
  id                  String   @id @default(uuid())
  name                String   @unique
  typebotId           String   @map("typebot_id")
  typebotHost         String   @map("typebot_host")
  apiToken            String?  @map("api_token")
  prefilledVariables  Json?    @map("prefilled_variables") // JSON object with user variables
  resultIdTemplate    String?  @map("result_id_template") // Template for resultId (e.g., "user-{userId}")
  sessionIdTemplate   String?  @map("session_id_template") // Template for sessionId
  storageType         String   @default("local") @map("storage_type") // "local" or "session"
  enableCallbacks     Boolean  @default(false) @map("enable_callbacks")
  onAnswerUrl         String?  @map("on_answer_url") // Webhook URL for onAnswer callback
  onInitUrl           String?  @map("on_init_url") // Webhook URL for onInit callback
  onEndUrl            String?  @map("on_end_url") // Webhook URL for onEnd callback
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("typebot_flows")
}

model TwilioMapping {
  id                        String   @id @default(uuid())
  name                      String // Friendly name for this mapping (required)
  phoneNumber               String   @map("phone_number") // Twilio phone number
  useMessagingService       Boolean  @default(false) @map("use_messaging_service")
  accountSid                String   @map("account_sid")
  authToken                 String   @map("auth_token")
  chatwootBaseUrl           String   @map("chatwoot_base_url") // Chatwoot instance URL
  chatwootApiToken          String?  @map("chatwoot_api_token") // Chatwoot API access token
  chatwootAccountId         String   @map("chatwoot_account_id") // Chatwoot account ID
  chatwootInboxId           String?  @map("chatwoot_inbox_id") // Chatwoot inbox ID
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([phoneNumber, active])
  @@map("twilio_mappings")
}

// Chatwoot Contact Cache
model ChatwootContact {
  id                String   @id @default(uuid())
  quepasaMappingId  String   @map("quepasa_mapping_id") // FK to QuepasaMapping
  chatwootContactId Int      @map("chatwoot_contact_id") // Contact ID in Chatwoot
  quepasaJid        String   @map("quepasa_jid") // WhatsApp JID (e.g., 5561999999999@s.whatsapp.net)
  phoneE164         String   @map("phone_e164") // Phone in E.164 format
  name              String?  // Contact name
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([quepasaMappingId, quepasaJid])
  @@unique([quepasaMappingId, chatwootContactId])
  @@index([phoneE164])
  @@map("chatwoot_contacts")
}

// Chatwoot Conversation Mapping
model ChatwootConversation {
  id                      String   @id @default(uuid())
  quepasaMappingId        String   @map("quepasa_mapping_id") // FK to QuepasaMapping
  chatwootConversationId  Int      @map("chatwoot_conversation_id") // Conversation ID in Chatwoot
  chatwootContactId       Int      @map("chatwoot_contact_id") // Contact ID in Chatwoot
  quepasaConversationId   String?  @map("quepasa_conversation_id") // Quepasa conversation ID (if provided)
  quepasaJid              String   @map("quepasa_jid") // WhatsApp JID
  status                  String   @default("open") // open, resolved, pending
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([quepasaMappingId, chatwootConversationId])
  @@index([quepasaMappingId, quepasaJid, status])
  @@map("chatwoot_conversations")
}

// Processed Messages (Idempotency)
model ProcessedMessage {
  id                String   @id @default(uuid())
  quepasaMappingId  String   @map("quepasa_mapping_id") // FK to QuepasaMapping
  externalId        String   @map("external_id") // message_id from Quepasa or Chatwoot
  source            String   // "quepasa" or "chatwoot"
  direction         String   // "incoming" or "outgoing"
  processedAt       DateTime @default(now()) @map("processed_at")

  @@unique([quepasaMappingId, externalId, source])
  @@index([externalId])
  @@index([processedAt])
  @@map("processed_messages")
}

// Message ID Mappings (for WhatsApp Reply functionality)
model MessageMapping {
  id                  Int      @id @default(autoincrement())
  chatwootMessageId   Int      @unique @map("chatwootMessageId")
  quepasaMessageId    String   @map("quepasaMessageId")
  conversationId      Int      @map("conversationId")
  createdAt           DateTime @default(now()) @map("createdAt")

  @@index([chatwootMessageId])
  @@index([conversationId])
  @@map("message_mappings")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  mfaEnabled Boolean  @default(false) @map("mfa_enabled")
  mfaSecret  String?  @map("mfa_secret")
  modules    String   @default("[\"all\"]") // Store as stringified JSON array
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("ativo") // ativo, concluido, cancelado
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tasks       ProjectTask[]
  milestones  ProjectMilestone[]
  members     ProjectMember[]
  files       ProjectFile[]
  discussions ProjectDiscussion[]

  @@map("projects")
}

model ProjectTask {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  milestoneId String?  @map("milestone_id")
  title       String
  description String?
  status      String   @default("pendente") // pendente, em_andamento, concluida
  priority    String?  @default("normal")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@map("project_tasks")
}

model ProjectMilestone {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  description String?
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       ProjectTask[]

  @@map("project_milestones")
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  email       String
  role        String   @default("Membro")
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_members")
}

model ProjectFile {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  url         String
  size        Int?
  type        String?
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model ProjectDiscussion {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  title       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments    ProjectDiscussionComment[]

  @@map("project_discussions")
}

model ProjectDiscussionComment {
  id           String   @id @default(uuid())
  discussionId String   @map("discussion_id")
  content      String
  authorId     String?  @map("author_id")
  authorName   String
  createdAt    DateTime @default(now()) @map("created_at")

  discussion   ProjectDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@map("project_discussion_comments")
}

// ==========================================
// Módulo de Atendimentos
// ==========================================

model Patient {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String?
  cpf         String?
  partnerId   String?  @map("partner_id")
  observations String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  partner     HealthPlan? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@map("patients")
}

model Practitioner {
  id            String   @id @default(uuid())
  name          String
  specialty     String?
  registrations String?
  email         String?
  phone         String?
  color         String?
  bufferMinutes Int      @default(0) @map("buffer_minutes")
  lunchBreak    Boolean  @default(false) @map("lunch_break")
  availableDays String   @default("[]") @map("available_days")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  appointments  Appointment[]

  @@map("practitioners")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  duration    Int      @default(60) // minutes
  price       Float    @default(0)
  color       String?
  online      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  appointments Appointment[]

  @@map("services")
}

model HealthPlan {
  id          String   @id @default(uuid())
  name        String
  type        String?
  paymentTerm String?  @map("payment_term")
  ansCode     String?  @map("ans_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  patients    Patient[]

  @@map("health_plans")
}

model Appointment {
  id              String   @id @default(uuid())
  patientId       String   @map("patient_id")
  practitionerId  String   @map("practitioner_id")
  serviceId       String   @map("service_id")
  startTime       DateTime @map("start_time")
  endTime         DateTime @map("end_time")
  status          String   @default("pendente") // pendente, confirmado, em_andamento, realizado, falta
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner    Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

// ==========================================
// Módulo de Disparos em Massa (Campaigns)
// ==========================================

model Campaign {
  id                String            @id @default(uuid())
  name              String
  description       String?
  source            String?           // csv, sanitizacao, tags, kanban
  rotationMode      String            @default("round_robin") @map("rotation_mode")
  minDelay          Int               @default(5) @map("min_delay")
  maxDelay          Int               @default(20) @map("max_delay")
  pauseEvery        Int               @default(0) @map("pause_every")
  pauseDuration     Int               @default(0) @map("pause_duration")
  messageContent    String            @map("message_content")
  status            String            @default("draft") // draft, running, paused, completed

  instances         CampaignInstance[]
  contacts          CampaignContact[]

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("campaigns")
}

model CampaignInstance {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  instanceId String   @map("instance_id")

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_instances")
}

model CampaignContact {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  phone      String
  name       String?
  selected   Boolean  @default(true)
  runStatus  String?  @default("Aguardando") @map("run_status")
  error      String?
  sentAt     DateTime? @map("sent_at")

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_contacts")
}
